# Optional — if set, vision uses your Roboflow model first.
# Rotate the key that was committed in detect.py on the public repo.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=garbage-classification-3/2

# Waste SigLIP2 head + acceptance rule (see README "Detection hardening")
SIGLIP_MODEL=prithivMLmods/Augmented-Waste-Classifier-SigLIP2
SIGLIP_THRESHOLD=0.25
SIGLIP_MARGIN=0.10

# Base SigLIP2 used as the zero-shot metal/glass optical grader
SIGLIP2_GRADER_MODEL=google/siglip2-base-patch16-224

# YOLO localiser (set YOLO_ENABLE=0 to classify the full frame instead)
YOLO_ENABLE=1
YOLO_MODEL=yolov8s.pt
YOLO_CONF=0.30

